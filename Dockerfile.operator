# Operator image (controller-runtime). Non-root distroless.
FROM golang:1.26-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/rehearsal-operator ./cmd/rehearsal-operator

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/rehearsal-operator /usr/local/bin/rehearsal-operator
USER nonroot:nonroot
ENTRYPOINT ["/usr/local/bin/rehearsal-operator"]
