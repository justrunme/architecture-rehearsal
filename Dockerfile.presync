# Argo CD PreSync gate image: rehearsal binary + kubectl for live collect / Application annotations.
FROM golang:1.27-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/rehearsal ./cmd/rehearsal

FROM alpine:3.24
# No default: BuildKit sets TARGETARCH per platform only when the ARG has no default value.
ARG TARGETARCH
ARG KUBECTL_VERSION=v1.32.3
RUN set -eu; arch="${TARGETARCH:-amd64}"; \
  apk add --no-cache ca-certificates curl; \
  curl -fsSL -o /usr/local/bin/kubectl "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${arch}/kubectl"; \
  echo "$(curl -fsSL "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${arch}/kubectl.sha256")  /usr/local/bin/kubectl" | sha256sum -c -; \
  chmod +x /usr/local/bin/kubectl; \
  adduser -D -u 65532 -g nonroot nonroot
COPY --from=build /out/rehearsal /usr/local/bin/rehearsal
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/rehearsal"]
CMD ["argo-presync", "--help"]
