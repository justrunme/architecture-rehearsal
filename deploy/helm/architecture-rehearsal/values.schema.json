{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "description": "Number of control plane replicas"
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "description": "Control plane image repository"
        },
        "tag": {
          "type": "string",
          "description": "Control plane image tag"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["IfNotPresent", "Always", "Never"],
          "description": "Image pull policy"
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Image pull secrets for private registries"
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Node selector for control plane pods"
    },
    "affinity": {
      "type": "object",
      "description": "Affinity rules for control plane pods"
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Tolerations for control plane pods"
    },
    "extraVolumes": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Extra volumes for control plane pods"
    },
    "extraVolumeMounts": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Extra volume mounts for control plane containers"
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"],
          "description": "Service type"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Service port"
        }
      }
    },
    "api": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable API server"
        },
        "token": {
          "type": "string",
          "description": "API authentication token (required unless existingSecret is set)"
        },
        "existingSecret": {
          "type": "string",
          "description": "Use existing secret for token"
        },
        "existingSecretKey": {
          "type": "string",
          "description": "Key in existing secret containing the token"
        },
        "org": {
          "type": "string",
          "description": "Default organization"
        },
        "role": {
          "type": "string",
          "description": "Default role"
        },
        "workDir": {
          "type": "string",
          "description": "Working directory for API server"
        },
        "async": {
          "type": "boolean",
          "description": "Enable async job processing"
        },
        "workers": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of async workers"
        }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable persistent storage"
        },
        "size": {
          "type": "string",
          "pattern": "^[0-9]+(Mi|Gi|Ti)$",
          "description": "PVC size"
        },
        "accessMode": {
          "type": "string",
          "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany"],
          "description": "PVC access mode"
        },
        "storageClass": {
          "type": "string",
          "description": "Storage class name"
        },
        "existingClaim": {
          "type": "string",
          "description": "Use existing PVC"
        }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "string",
              "description": "CPU request"
            },
            "memory": {
              "type": "string",
              "description": "Memory request"
            }
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "string",
              "description": "CPU limit"
            },
            "memory": {
              "type": "string",
              "description": "Memory limit"
            }
          }
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable PodDisruptionBudget for control plane"
        },
        "minAvailable": {
          "oneOf": [
            {"type": "integer", "minimum": 1},
            {"type": "string", "pattern": "^[0-9]+%$"}
          ],
          "description": "Minimum available pods (number or percentage)"
        },
        "maxUnavailable": {
          "oneOf": [
            {"type": "integer", "minimum": 1},
            {"type": "string", "pattern": "^[0-9]+%$"}
          ],
          "description": "Maximum unavailable pods (number or percentage)"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable NetworkPolicy for control plane"
        },
        "ingressRules": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Custom ingress rules"
        },
        "egressRules": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Custom egress rules"
        }
      }
    },
    "objectStorage": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable S3-compatible object storage"
        },
        "endpoint": {
          "type": "string",
          "description": "Object storage endpoint"
        },
        "bucket": {
          "type": "string",
          "description": "Object storage bucket"
        }
      }
    },
    "postgresql": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable PostgreSQL backend"
        },
        "host": {
          "type": "string",
          "description": "PostgreSQL host"
        },
        "database": {
          "type": "string",
          "description": "PostgreSQL database"
        }
      }
    },
    "operator": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable Kubernetes operator"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of operator replicas"
        },
        "leaderElection": {
          "type": "boolean",
          "description": "Enable leader election"
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "description": "Operator image repository"
            },
            "tag": {
              "type": "string",
              "description": "Operator image tag"
            },
            "pullPolicy": {
              "type": "string",
              "enum": ["IfNotPresent", "Always", "Never"],
              "description": "Image pull policy"
            }
          }
        },
        "controlPlaneURL": {
          "type": "string",
          "description": "Override control plane URL"
        },
        "existingSecret": {
          "type": "string",
          "description": "Use existing secret for token"
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Image pull secrets for operator"
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Node selector for operator pods"
        },
        "affinity": {
          "type": "object",
          "description": "Affinity rules for operator pods"
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Tolerations for operator pods"
        },
        "podDisruptionBudget": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable PodDisruptionBudget for operator"
            },
            "minAvailable": {
              "oneOf": [
                {"type": "integer", "minimum": 1},
                {"type": "string", "pattern": "^[0-9]+%$"}
              ],
              "description": "Minimum available pods (number or percentage)"
            },
            "maxUnavailable": {
              "oneOf": [
                {"type": "integer", "minimum": 1},
                {"type": "string", "pattern": "^[0-9]+%$"}
              ],
              "description": "Maximum unavailable pods (number or percentage)"
            }
          }
        },
        "networkPolicy": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable NetworkPolicy"
            },
            "kubeAPIServerCIDRs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$"
              },
              "description": "CIDRs for Kubernetes API access"
            }
          }
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "string",
                  "description": "CPU request"
                },
                "memory": {
                  "type": "string",
                  "description": "Memory request"
                }
              }
            },
            "limits": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "string",
                  "description": "CPU limit"
                },
                "memory": {
                  "type": "string",
                  "description": "Memory limit"
                }
              }
            }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean",
          "description": "Create service account"
        },
        "name": {
          "type": "string",
          "description": "Service account name"
        }
      }
    },
    "rbac": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean",
          "description": "Create RBAC resources"
        }
      }
    },
    "argoPresync": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable Argo CD PreSync gate"
        },
        "includeHookJob": {
          "type": "boolean",
          "description": "Include PreSync Job template"
        },
        "clusterRBAC": {
          "type": "boolean",
          "description": "Enable cluster-level RBAC"
        },
        "desiredConfigMap": {
          "type": "string",
          "description": "ConfigMap name for desired state"
        },
        "appName": {
          "type": "string",
          "description": "Argo CD Application name"
        },
        "appNamespace": {
          "type": "string",
          "description": "Argo CD namespace"
        },
        "timeout": {
          "type": "string",
          "pattern": "^[0-9]+(s|m|h)$",
          "description": "PreSync timeout"
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "description": "PreSync image repository"
            },
            "tag": {
              "type": "string",
              "description": "PreSync image tag"
            },
            "pullPolicy": {
              "type": "string",
              "enum": ["IfNotPresent", "Always", "Never"],
              "description": "Image pull policy"
            }
          }
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Image pull secrets for PreSync"
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "string",
                  "description": "CPU request"
                },
                "memory": {
                  "type": "string",
                  "description": "Memory request"
                }
              }
            },
            "limits": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "string",
                  "description": "CPU limit"
                },
                "memory": {
                  "type": "string",
                  "description": "Memory limit"
                }
              }
            }
          }
        }
      }
    }
  }
}
